# Environment Configuration for NVIDIA NIM LOCAL DEPLOYMENT

# === NVIDIA NIM CONTAINER CONFIGURATION ===
# NGC API Key (required for NIM containers)
NGC_API_KEY=your-ngc-api-key-here

# NIM Container Settings
MODEL_DIRECTORY=${HOME}/.cache/nim
USERID=1000
INFERENCE_GPU_COUNT=1
EMBEDDING_MS_GPU_ID=0
LLM_MS_GPU_ID=0
RANKING_MS_GPU_ID=0

# LLM Configuration (NIM LLM Container)
APP_LLM_MODELNAME=meta/llama3-8b-instruct
APP_LLM_MODELENGINE=nvidia_ai_endpoints
APP_LLM_SERVERURL=http://nemollm-inference-microservice:8000

# Embedding Configuration (NIM Embedding Container)
APP_EMBEDDINGS_MODELNAME=nvidia/nv-embedqa-e5-v5
APP_EMBEDDINGS_MODELENGINE=nvidia_ai_endpoints
APP_EMBEDDINGS_SERVERURL=http://nemo-retriever-embedding-microservice:8000

# Ranking/Reranking Configuration (Optional)
APP_RANKING_MODELNAME=nvidia/nv-rerankqa-mistral-4b-v3
APP_RANKING_SERVERURL=http://nemo-retriever-ranking-microservice:8000

# === ALTERNATIVE: CLOUD MODEL CONFIGURATION ===
# Uncomment these lines to use NVIDIA cloud APIs instead of local NIM
# NVIDIA_API_KEY=nvapi-your-key-here
# APP_LLM_SERVERURL=
# APP_EMBEDDINGS_SERVERURL=

# Vector Store Configuration
APP_VECTORSTORE_NAME=milvus
APP_VECTORSTORE_URL=http://milvus-standalone:19530

# Text Splitter Configuration
APP_TEXTSPLITTER_MODELNAME=nvidia/nv-embedqa-e5-v5
APP_TEXTSPLITTER_CHUNKSIZE=512
APP_TEXTSPLITTER_CHUNKOVERLAP=50

# Retriever Configuration
APP_RETRIEVER_TOPK=5
APP_RETRIEVER_SCORETHRESHOLD=0.25

# Server Configuration
CHAIN_SERVER_HOST=0.0.0.0
CHAIN_SERVER_PORT=8081
RAG_PLAYGROUND_HOST=0.0.0.0
RAG_PLAYGROUND_PORT=8090

# Milvus Configuration
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_USERNAME=
MILVUS_PASSWORD=

# PostgreSQL Configuration (if using pgvector)
POSTGRES_PASSWORD=password
POSTGRES_USER=postgres
POSTGRES_DB=api

# Docker Configuration
DOCKER_VOLUME_DIRECTORY=./volumes

# Optional: OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Optional: LangSmith Configuration (for tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# === PERFORMANCE TUNING ===
# Model Performance Settings
MAX_TOKENS=2048
TEMPERATURE=0.7
TOP_P=0.9
CONTEXT_LENGTH=4096

# Resource Limits
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=300

# Logging Configuration
LOGLEVEL=INFO
LOG_FORMAT=json
