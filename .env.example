# LLM Server Configuration - Optimized for Code Models

# Model Configuration (Local models take priority)
# For Code Models: CodeLlama-13B, StarCoder-15B, DeepSeek-Coder
HF_MODEL_LOCAL_PATH=./models/CodeLlama-7b-Instruct-hf
HF_MODEL_NAME=codellama/CodeLlama-7b-Instruct-hf

# Alternative models (uncomment to use):
# HF_MODEL_LOCAL_PATH=./models/starcoder
# HF_MODEL_NAME=bigcode/starcoder
# HF_MODEL_LOCAL_PATH=./models/deepseek-coder-6.7b-instruct
# HF_MODEL_NAME=deepseek-ai/deepseek-coder-6.7b-instruct

# HuggingFace Settings
TRUST_REMOTE_CODE=false

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Performance Settings (auto = smart detection)
DEVICE=auto              # auto, cpu, cuda - auto detects best option
TORCH_DTYPE=auto         # auto, float32, float16 - auto chooses compatible dtype
LOW_CPU_MEM_USAGE=true   # Optimize memory usage

# Logging
LOG_LEVEL=INFO           # DEBUG, INFO, WARNING, ERROR
